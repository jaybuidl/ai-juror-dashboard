{
  "name": "@kleros/ai-juror-dashboard",
  "version": "0.1.0",
  "description": "Speed and coherence of six AI agent jurors in Kleros v2 court 34 on Arbitrum One",
  "private": true,
  "type": "module",
  "license": "MIT",
  "packageManager": "yarn@4.18.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "start": "vite",
    "build": "yarn check-types && vite build",
    "build:ci": "yarn verify && vite build",
    "preview": "vite preview",
    "check-types": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "verify": "yarn lint && yarn check-types && yarn test"
  },
  "dependencies": {
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "styled-components": "^6.5.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.20.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^6.1.0",
    "jsdom": "^30.0.0",
    "typescript": "^7.0.0",
    "vite": "^8.2.0",
    "vitest": "^4.1.0"
  },
  "volta": {
    "node": "22.23.2",
    "yarn": "4.18.0"
  }
}
