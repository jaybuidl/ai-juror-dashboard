{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "forceConsistentCasingInFileNames": true,

    "verbatimModuleSyntax": true,
    "isolatedModules": true,
    "useDefineForClassFields": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "noEmit": true,

    // Empty on purpose: this program is browser code, so no ambient @types package
    // is loaded automatically and `process`, `Buffer` and `__dirname` are type errors
    // here. Without it they typecheck cleanly, survive the bundler, and fail at runtime
    // on a public page. The trap is live — agentkit's getSubgraphUrl reads process.env,
    // and ADR-0003 has metric code moving between the two repos in both directions.
    // Browser globals still arrive: src/vite-env.d.ts references vite/client explicitly.
    // vite.config.ts is checked separately by tsconfig.node.json, which does load them.
    "types": [],

    // No baseUrl: it is deprecated in TS 6 and removed in TS 7. Since TS 5.0
    // `paths` resolves relative to this file, which is what we want anyway.
    "paths": {
      "src/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
